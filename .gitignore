# Hugo's image/SCSS processing cache. Regenerated from content/ and assets/ on every
# build, so there is nothing here that cannot be rebuilt. It was previously tracked
# (479 files); the Hugo 0.169 upgrade changed the generated-image naming scheme, which
# would have orphaned every one of them and added ~90 new ones on each future build.
resources/_gen/

# Hugo's concurrent-build lock. Transient.
.hugo_build.lock

# Windows / OneDrive droppings (the 38 that had been committed were removed 2026-11-14).
desktop.ini
Thumbs.db
ehthumbs.db
